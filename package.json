{
  "name": "costear-backend",
  "version": "0.1.0",
  "description": "CosteAR — API de automatización de costos para profesionales argentinos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/infrastructure/http/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/infrastructure/http/entry.js",
    "start:worker": "node dist/infrastructure/workers/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node scripts/migrate-deploy.mjs",
    "db:rls": "node scripts/apply-rls.mjs",
    "db:seed": "node prisma/seed.mjs",
    "db:setup": "prisma migrate dev --name init && node scripts/apply-rls.mjs",
    "worker": "tsx --env-file=.env src/infrastructure/workers/index.ts",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
