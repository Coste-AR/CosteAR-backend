NODE_ENV=development
PORT=3000
API_VERSION=v1

# Postgres y Redis — los puertos son los que MAPEA docker-compose.yml al host
# (5433 y 6380, no los de adentro del contenedor).
# Dos roles a propósito: migraciones y RLS se aplican con el dueño `costear`;
# la app y `npm run test:integration` usan `costear_app`, que NO puede saltear
# RLS. Para crearlos desde cero: docker compose down -v && docker compose up -d.
MIGRATION_DATABASE_URL=postgresql://costear:costear@localhost:5433/costear
DATABASE_URL=postgresql://costear_app:costear_app@localhost:5433/costear
APP_DB_ROLE=costear_app
APP_DB_PASSWORD=costear_app
REDIS_URL=redis://localhost:6380

# Generar con: npm run keys:generate
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

COOKIE_SECRET=cambiar-por-32-caracteres-aleatorios
TOTP_ENCRYPTION_KEY=exactamente-32-caracteres-aqui!!
ARGON2_PEPPER=cambiar-por-pepper-aleatorio

# Email
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@costear.com

# IA — Groq (OCR de comprobantes + fallback del clasificador + consejero)
# SIN una key válida (formato gsk_...), la lectura de FOTOS de comprobantes y el
# desempate por IA quedan desactivados: todo cae a reglas deterministas / revisión
# humana. Free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# IA — Voyage AI (embeddings para indexar la bóveda de costeo, comando `npm run vault:index`)
# SIN una key válida, el indexador falla explícitamente al arrancar: sin
# embeddings no hay forma de indexar. Conseguir key en https://www.voyageai.com/
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxx

# Sentry — secreto para verificar la firma HMAC del webhook entrante
# (POST /webhooks/sentry). Sin esto, el webhook rechaza todo (falla cerrado).
# Se obtiene en Sentry: Settings → Developer Settings → tu integración interna
# → Webhooks → "Client Secret".
SENTRY_WEBHOOK_SECRET=

# WhatsApp (Meta) — App Secret para verificar la firma X-Hub-Signature-256
# del webhook entrante. Meta App Dashboard → Settings → Basic → App Secret.
# Sin esto, /webhooks/whatsapp rechaza todo (falla cerrado).
WHATSAPP_APP_SECRET=

# Telegram — token del bot de ingesta. Se configura solo en el entorno.
TELEGRAM_BOT_TOKEN=

# APIs externas
BCRA_API_URL=https://api.bcra.gob.ar
INDEC_API_URL=https://apis.datos.gob.ar/series/api

# Frontend
CORS_ORIGIN=http://localhost:5173

# Workers
MACRO_SYNC_CRON=0 18 * * 1-5
VAULT_GITHUB_TOKEN=

# Seeds de desarrollo local (npm run db:seed / scripts/create-operator.mjs)
# No usar valores reales. Estas credenciales son solo para entornos de desarrollo.
DEMO_EMAIL=demo@costear.com
DEMO_PASSWORD=
OPERATOR_EMAIL=operator@costear.com
OPERATOR_PASSWORD=
OPERATOR_API_KEY=
