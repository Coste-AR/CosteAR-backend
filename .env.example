NODE_ENV=development
PORT=3000
API_VERSION=v1

# Postgres y Redis (coinciden con docker-compose.yml)
DATABASE_URL=postgresql://costear:costear@localhost:5432/costear
REDIS_URL=redis://localhost:6379

# Generar con: npm run keys:generate
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

COOKIE_SECRET=cambiar-por-32-caracteres-aleatorios
TOTP_ENCRYPTION_KEY=exactamente-32-caracteres-aqui!!
ARGON2_PEPPER=cambiar-por-pepper-aleatorio

# Email
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@costear.com

# IA — Voyage AI (embeddings para indexar la bóveda de costeo, comando `npm run vault:index`)
# SIN una key válida, el indexador falla explícitamente al arrancar: sin
# embeddings no hay forma de indexar. Conseguir key en https://www.voyageai.com/
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxx

# APIs externas
BCRA_API_URL=https://api.bcra.gob.ar
INDEC_API_URL=https://apis.datos.gob.ar/series/api

# Frontend
CORS_ORIGIN=http://localhost:5173

# Workers
MACRO_SYNC_CRON=0 18 * * 1-5
