// CosteAR — Modelo de datos
// Multi-tenant: cada User es un tenant. El aislamiento se refuerza con
// Row-Level Security a nivel PostgreSQL (ver migration rls.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidad y seguridad
// ---------------------------------------------------------------------------

enum UserRole {
  COSTISTA
  ADMIN
  EMPRESA_OPERATOR // personal de la empresa cliente, solo puede subir documentos
}

enum ProfessionalType {
  CONTADOR_PUBLICO
  LIC_ADMINISTRACION
  CONSULTOR_INDEPENDIENTE
  ANALISTA_INTERNO
  OTRO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(COSTISTA)

  // Datos profesionales (capturados en el onboarding)
  // cuit es el identificador de login (único, nullable solo para retrocompatibilidad)
  cuit             String?           @unique // CUIT / CUIL del profesional (11 dígitos)
  dni              String?
  professionalType ProfessionalType?
  licenseNumber    String? // matrícula profesional (CPCE)
  province         String?
  onboardedAt      DateTime? // marca cuándo completó el alta guiada
  avatarUrl        String? // URL de Cloudinary de la foto de perfil

  // 2FA (TOTP)
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String? // cifrado AES-256 en reposo
  twoFactorBackupCodes String[] @default([]) // hashes Argon2id de un solo uso

  // Estado de cuenta / anti-bruteforce
  isActive            Boolean   @default(true)
  isLocked            Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean   @default(false) // true en operadores invitados hasta que cambien la clave

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies          Company[]
  refreshTokens      RefreshToken[]
  alerts             Alert[]
  auditLogs          AuditLog[]
  dataPointVersions  DataPointVersion[]
  evidences          Evidence[]
  calculationRuns    CalculationRun[]
  passwordResets     PasswordReset[]
  alertSettings      AlertSetting?
  costistConnections EmpresaConnection[]  @relation("costist_connections")
  // Para EMPRESA_OPERATOR: puede pertenecer a varias empresas
  memberships        OperatorMembership[]
  sentInvites        OperatorInvite[]     @relation("invite_sender")
  receivedInvites    OperatorInvite[]     @relation("invite_receiver")

  // Trazabilidad Total v1 (ver sección al final del archivo)
  traceAuditLogs TraceAuditLog[]

  @@map("users")
}

// Refresh tokens opacos, rotados en cada uso. Se guarda solo el hash.
// `familyId` agrupa la cadena de rotación: si se detecta reuso de un token
// ya rotado, se invalida toda la familia (robo de sesión).
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  // Cuando se rota, apunta al token que lo reemplazó (para detectar reuso).
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Cartera de clientes (PyMEs)
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  cuit        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  costStructures     CostStructure[]
  alerts             Alert[]
  empresaConnections EmpresaConnection[]

  @@index([userId])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Estructura de costos (por empresa × producto × período)
// ---------------------------------------------------------------------------

enum CostStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CostingSystem {
  ORDERS
  PROCESSES
}

model CostStructure {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @db.Uuid
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String              @db.Uuid // denormalizado para RLS
  productName   String
  period        String // "YYYY-MM"
  status        CostStructureStatus @default(DRAFT)
  costingSystem CostingSystem       @default(ORDERS)

  // Configuración de los tres elementos del costo (JSONB tipado en la app).
  rawMaterialConfig  Json?
  directLaborConfig  Json?
  indirectCostConfig Json?

  // Datos de venta para el cálculo de margen.
  salesUnitPrice Decimal? @db.Decimal(18, 4)
  salesQuantity  Decimal? @db.Decimal(18, 4)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft-delete: si está seteado, la estructura está "en la papelera" y puede
  // recuperarse. Las listas la excluyen por defecto.
  deletedAt DateTime?

  calculations    CostCalculation[]
  alerts          Alert[]
  dataEntries     DataEntry[]
  // Trazabilidad Total v1 (ver sección al final del archivo)
  dataPoints      DataPoint[]
  calculationRuns CalculationRun[]

  @@index([companyId])
  @@index([userId])
  @@map("cost_structures")
}

// Resultado de un cálculo. Inmutable: cada recálculo crea un registro nuevo,
// preservando la trazabilidad histórica (qué datos macro se usaron, cuándo).
model CostCalculation {
  id              String        @id @default(uuid()) @db.Uuid
  costStructureId String        @db.Uuid
  costStructure   CostStructure @relation(fields: [costStructureId], references: [id], onDelete: Cascade)
  userId          String        @db.Uuid
  macroSnapshotId String?       @db.Uuid

  rawMaterialConsumed  Decimal @db.Decimal(18, 4)
  directLaborTotal     Decimal @db.Decimal(18, 4)
  indirectCostsApplied Decimal @db.Decimal(18, 4)
  productionCost       Decimal @db.Decimal(18, 4)
  costOfGoodsSold      Decimal @db.Decimal(18, 4)
  grossMargin          Decimal @db.Decimal(18, 4)
  grossMarginPct       Decimal @db.Decimal(9, 4)

  // Snapshot completo del resultado para auditoría / reconstrucción.
  detail Json

  calculatedAt DateTime @default(now())

  @@index([costStructureId])
  @@index([userId])
  @@map("cost_calculations")
}

// ---------------------------------------------------------------------------
// Datos macroeconómicos (BCRA, INDEC, ARCA, paritarias)
// ---------------------------------------------------------------------------

enum MacroSource {
  BCRA
  INDEC
  ARCA
  PARITARIA
}

// Inmutable: nunca se edita, solo se insertan nuevos snapshots.
model MacroSnapshot {
  id            String      @id @default(uuid()) @db.Uuid
  source        MacroSource
  indicatorCode String // ej. "USD_OFICIAL", "IPC_NACIONAL", "PARITARIA_METALURGICO"
  value         Decimal     @db.Decimal(18, 6)
  effectiveDate DateTime
  fetchedAt     DateTime    @default(now())
  metadata      Json?

  @@unique([source, indicatorCode, effectiveDate])
  @@index([source, indicatorCode])
  @@map("macro_snapshots")
}

// ---------------------------------------------------------------------------
// Alertas
// ---------------------------------------------------------------------------

enum AlertType {
  MARGIN_BELOW_THRESHOLD
  MACRO_CHANGE
  COST_SPIKE
}

model Alert {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String?        @db.Uuid
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  costStructureId String?        @db.Uuid
  costStructure   CostStructure? @relation(fields: [costStructureId], references: [id], onDelete: SetNull)

  type        AlertType
  message     String
  threshold   Decimal?  @db.Decimal(18, 4)
  actualValue Decimal?  @db.Decimal(18, 4)

  isRead      Boolean   @default(false)
  emailSentAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([costStructureId])
  @@map("alerts")
}

model AlertSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Umbral de margen (%) bajo el cual se dispara la alerta.
  marginThresholdPct Decimal  @default(15) @db.Decimal(9, 4)
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("alert_settings")
}

// ---------------------------------------------------------------------------
// Conexiones empresa ↔ costista (data lake por par)
// ---------------------------------------------------------------------------

// Una empresa puede estar conectada a uno o más costistas.
// Cada conexión tiene su propio espacio de datos (data lake).
model EmpresaConnection {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costistId String   @db.Uuid
  costist   User     @relation("costist_connections", fields: [costistId], references: [id], onDelete: Cascade)
  apiKey    String   @unique @default(uuid()) // clave para que la empresa suba datos
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataEntries DataEntry[]
  memberships OperatorMembership[]
  invites     OperatorInvite[]

  @@unique([companyId, costistId])
  @@index([costistId])
  @@map("empresa_connections")
}

// Un operador puede pertenecer a N empresas (una membership por empresa)
model OperatorMembership {
  id           String            @id @default(uuid()) @db.Uuid
  operatorId   String            @db.Uuid
  operator     User              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  connectionId String            @db.Uuid
  connection   EmpresaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  isActive     Boolean           @default(true)
  joinedAt     DateTime          @default(now())

  @@unique([operatorId, connectionId])
  @@index([operatorId])
  @@index([connectionId])
  @@map("operator_memberships")
}

// Código de invitación para que un operador se una a una empresa
model OperatorInvite {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique // código legible, ej: "THIBAUT-X7K2"
  connectionId String            @db.Uuid
  connection   EmpresaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  costistId    String            @db.Uuid // quien generó la invitación
  costist      User              @relation("invite_sender", fields: [costistId], references: [id], onDelete: Cascade)
  inviteeEmail String // email al que se invitó
  inviteeId    String?           @db.Uuid // se rellena cuando acepta
  invitee      User?             @relation("invite_receiver", fields: [inviteeId], references: [id], onDelete: SetNull)
  status       InviteStatus      @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([code])
  @@index([connectionId])
  @@index([inviteeEmail])
  @@map("operator_invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Entradas de datos (cargadas por la empresa, validadas por el costista)
// ---------------------------------------------------------------------------

enum DataEntryStatus {
  PENDING // recién cargada, esperando revisión
  APPROVED // el costista la aprobó y actualizó la estructura de costos
  REJECTED // el costista la rechazó (no es válida o ya está cubierta)
  CORRECTED // el costista la corrigió antes de aprobar
}

enum DataEntrySourceType {
  TEXT
  PDF
  IMAGE
  WHATSAPP
}

model DataEntry {
  id           String            @id @default(uuid()) @db.Uuid
  connectionId String            @db.Uuid
  connection   EmpresaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  costistId    String            @db.Uuid // denormalizado para RLS y queries rápidas

  rawContent String // texto libre / descripción del documento
  sourceType DataEntrySourceType @default(TEXT)
  status     DataEntryStatus     @default(PENDING)

  // Adjunto (PDF o imagen)
  fileName     String? // nombre original del archivo
  fileData     String? // base64 legacy — no se usa para uploads nuevos
  fileMimeType String? // ej: "application/pdf", "image/jpeg"
  fileUrl      String? // URL de Cloudinary (reemplaza fileData)

  // Clave fuerte de deduplicación (proveedor|nro comprobante normalizado).
  // Permite detectar reenvíos del mismo documento aunque no tenga CAE.
  dedupeKey String?

  // Contenido corregido (si el costista modificó antes de aprobar)
  correctedContent String?

  // Nota interna del costista al aprobar / rechazar
  reviewNote   String?
  costistaNote String?
  reviewedAt   DateTime?
  reviewedBy   String?   @db.Uuid

  // Producto/estructura de costos al que apunta este dato. Si está seteado, la
  // auto-población al aprobar va EXACTAMENTE a esa estructura (aislamiento por
  // producto). Si es null, se cae al comportamiento anterior (estructura activa).
  costStructureId String?        @db.Uuid
  costStructure   CostStructure? @relation(fields: [costStructureId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history              ValidationHistory[]
  classificationAudits ClassificationAudit[]

  @@index([connectionId])
  @@index([costistId, status])
  @@index([connectionId, dedupeKey])
  @@index([costStructureId])
  @@map("data_entries")
}

// ---------------------------------------------------------------------------
// Historial de validaciones (inmutable, trazabilidad)
// ---------------------------------------------------------------------------

model ValidationHistory {
  id        String    @id @default(uuid()) @db.Uuid
  entryId   String    @db.Uuid
  entry     DataEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  costistId String    @db.Uuid

  fromStatus DataEntryStatus
  toStatus   DataEntryStatus
  note       String?
  createdAt  DateTime        @default(now())

  @@index([entryId])
  @@map("validation_history")
}

// ---------------------------------------------------------------------------
// Auditoría (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // ej. "auth.login.success", "company.create", "cost_structure.update"
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Clasificador de documentos en cascada
// ---------------------------------------------------------------------------

// Aprende de cada proveedor validado: CUIT → tipo + sección habitual.
// Se actualiza cada vez que el costista aprueba/corrige una entrada.
// Scoped por costistId para que cada costista tenga su propia base.
model SupplierFingerprint {
  id               String   @id @default(uuid()) @db.Uuid
  costistId        String   @db.Uuid // costista propietario
  companyId        String   @db.Uuid // empresa específica (proveedor puede vender distinto a distintas empresas)
  supplierCuit     String // CUIT del proveedor (sin guiones: 11 dígitos)
  documentType     String // tipo más frecuente: FACTURA_COMPRA, etc.
  costSection      String // sección más frecuente: MATERIA_PRIMA, etc.
  timesSeenCorrect Int      @default(0)
  timesOverridden  Int      @default(0)
  confidenceBonus  Int      @default(0) // calculado: min(25, timesSeenCorrect * 5)
  updatedAt        DateTime @updatedAt

  @@unique([costistId, supplierCuit, companyId])
  @@index([costistId])
  @@map("supplier_fingerprints")
}

// Log inmutable de cada clasificación realizada.
model ClassificationAudit {
  id          String    @id @default(uuid()) @db.Uuid
  dataEntryId String    @db.Uuid
  dataEntry   DataEntry @relation(fields: [dataEntryId], references: [id], onDelete: Cascade)
  companyId   String    @db.Uuid
  costistId   String    @db.Uuid

  // Pipeline results
  qualityGate             String // PASS | PARTIAL | FAIL
  definitiveSignal        String? // señal de capa 1 que disparó
  corroboratingSignals    Json // SignalResult[]
  numericValidationDelta  Int     @default(0)
  supplierFingerprintUsed Boolean @default(false)
  aiUsed                  Boolean @default(false)
  confidenceCap           Int? // 65 si calidad parcial

  // Final result
  documentType     String // FACTURA_COMPRA, REMITO, etc.
  costSection      String // MATERIA_PRIMA, etc.
  confidence       Int
  requiresReview   Boolean @default(false)
  intent           String  @default("DOCUMENTO_FORMAL") // InputIntent
  industryCategory String  @default("DEFAULT") // IndustryCategory
  explanation      String? // explicación legible para el costista

  // Human validation (filled in by validaciones-service on review)
  validatedByCostista Boolean   @default(false)
  costaValidatedAt    DateTime?
  costaOverrode       Boolean   @default(false)
  costaCorrection     Json? // { type?, section? }

  createdAt DateTime @default(now())

  @@index([dataEntryId])
  @@index([costistId])
  @@map("classification_audits")
}

// Registro de CAEs ya procesados para detectar documentos duplicados.
model ProcessedCAE {
  id          String   @id @default(uuid()) @db.Uuid
  cae         String   @unique
  dataEntryId String   @db.Uuid
  companyId   String   @db.Uuid
  processedAt DateTime @default(now())

  @@index([companyId])
  @@map("processed_caes")
}

// Libro mayor de costos respaldado por documentos.
// Cada documento que el costista aprueba/corrige genera una línea acá:
// el costo real, su período, su sección y un link a su documento de origen.
// Es la fuente de verdad trazable de "qué se gastó", separada del modelo
// parametrizado de la estructura de costos (que no se toca automáticamente).
model CostLedgerEntry {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  costistId   String  @db.Uuid // denormalizado para queries rápidas
  dataEntryId String? @db.Uuid // documento de origen (trazabilidad)

  period       String // "YYYY-MM" (del documento, no de la aprobación)
  costSection  String // MATERIA_PRIMA | MANO_DE_OBRA | COSTOS_INDIRECTOS | VENTAS
  documentType String
  supplier     String?
  description  String
  amount       Decimal   @db.Decimal(18, 4)
  currency     String    @default("ARS")
  docDate      DateTime?

  // Procedencia de la clasificación (para marcar qué mirar con lupa).
  sourceImageUrl String? // foto/PDF del documento original
  confidence     Int?
  aiUsed         Boolean @default(false)
  wasCorrected   Boolean @default(false) // el costista corrigió antes de aprobar

  createdAt DateTime @default(now())

  @@index([companyId, period, costSection])
  @@index([costistId, period])
  @@index([dataEntryId])
  @@map("cost_ledger_entries")
}

// ---------------------------------------------------------------------------
// Trazabilidad Total v1
//
// Modelo append-only para el origen de cada dato de costeo (quién, cuándo,
// desde dónde) y el árbol de derivación de cada cálculo. No reemplaza ni
// altera las tablas de arriba: es una capa adicional. `CostCalculation` y el
// audit log legado (`AuditLog`) se mantienen intactos para no romper nada que
// ya los use; ver DECISIONES.md para el razonamiento.
// ---------------------------------------------------------------------------

enum SourceArea {
  deposito
  contaduria
  planta
  comercial
  costista
  sistema
}

enum CaptureMethod {
  manual
  portal_operador
  ia_sugerido
  excel_import
  calculado
}

enum DataStatus {
  borrador
  validado
  aplicado
  anulado
}

enum CostElement {
  MP
  MOD
  CIP
  VENTA
}

// Un "dato" trazable dentro de una estructura de costos (ej. el precio de una
// compra, las horas de un depto, un concepto de CIF). Su valor vive en
// `DataPointVersion` — este modelo es el contenedor estable que agrupa todas
// las versiones de ese dato a lo largo del tiempo.
model DataPoint {
  id              String        @id @default(uuid()) @db.Uuid
  structureId     String        @db.Uuid
  structure       CostStructure @relation(fields: [structureId], references: [id])
  element         CostElement
  fieldKey        String // ej 'mp.compra.precio', 'mod.dpto.horas', 'cip.concepto.importe'
  label           String // ej 'Compra — Proveedor Central'
  unit            String? // '$','hs','%','u'
  sourceArea      SourceArea
  status          DataStatus    @default(borrador)
  fechaHecho      DateTime?     @db.Date
  fechaCaptacion  DateTime      @default(now()) @db.Timestamptz
  periodoImputado String? // 'YYYY-MM'; NULL = pendiente de decisión
  voidedAt        DateTime?     @db.Timestamptz
  createdAt       DateTime      @default(now()) @db.Timestamptz

  versions DataPointVersion[]

  @@index([structureId])
  @@index([structureId, element])
  @@index([periodoImputado])
  @@map("data_points")
}

// Cada versión de un DataPoint. INMUTABLE (trigger BEFORE UPDATE/DELETE en la
// migración de abajo): una corrección SIEMPRE crea una fila nueva con
// version_n + 1, nunca pisa la anterior.
model DataPointVersion {
  id            String        @id @default(uuid()) @db.Uuid
  dataPointId   String        @db.Uuid
  dataPoint     DataPoint     @relation(fields: [dataPointId], references: [id])
  versionN      Int
  valueNum      Decimal?      @db.Decimal(18, 4)
  valueJson     Json? // compuestos (cantidad+precio comparten movement_id acá)
  reason        String? // obligatorio si version_n > 1 (validado en la app)
  evidenceId    String?       @db.Uuid
  evidence      Evidence?     @relation(fields: [evidenceId], references: [id])
  method        CaptureMethod
  createdBy     String        @db.Uuid
  createdByUser User          @relation(fields: [createdBy], references: [id])
  actorRole     String
  actorArea     SourceArea
  deviceInfo    String?
  createdAt     DateTime      @default(now()) @db.Timestamptz

  @@unique([dataPointId, versionN])
  @@index([dataPointId])
  @@map("data_point_versions")
}

model Evidence {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String
  reference      String
  counterparty   String?
  fileUrl        String?
  uploadedBy     String?  @db.Uuid
  uploadedByUser User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedAt     DateTime @default(now()) @db.Timestamptz

  versions DataPointVersion[]

  @@map("evidence")
}

// Bitácora append-only dedicada a las acciones de trazabilidad (crear,
// versionar, validar, aplicar, anular, calcular, imputar, pedir_revision...).
// Nombre distinto de `AuditLog` (audit_logs) a propósito: esa tabla legada ya
// tiene su propio esquema y consumidores; no se toca (R1).
model TraceAuditLog {
  id         BigInt         @id @default(autoincrement())
  entityType String
  entityId   String
  action     String // crear|versionar|validar|aplicar|anular|calcular|imputar|proponer_ia|confirmar_ia|pedir_revision
  actorId    String?        @db.Uuid
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String
  actorArea  SourceArea
  method     CaptureMethod?
  deviceInfo String?
  before     Json?
  after      Json?
  comment    String?
  at         DateTime       @default(now()) @db.Timestamptz

  @@index([entityType, entityId, at(sort: Desc)])
  @@map("trace_audit_log")
}

// Una corrida del motor de cálculo. Inmutable — cada recálculo es un run
// nuevo con su propio árbol de nodos.
model CalculationRun {
  id             String        @id @default(uuid()) @db.Uuid
  structureId    String        @db.Uuid
  structure      CostStructure @relation(fields: [structureId], references: [id])
  runN           Int
  engineVersion  String
  executedBy     String        @db.Uuid
  executedByUser User          @relation(fields: [executedBy], references: [id])
  executedAt     DateTime      @default(now()) @db.Timestamptz
  inputsSnapshot Json
  results        Json

  nodes CalculationNode[]

  @@unique([structureId, runN])
  @@map("calculation_runs")
}

// Un nodo del árbol de derivación de un run (raíz = elemento MP/MOD/CIP/VENTA
// o el resultado final; hijos = sub-cálculos). El frontend hace drill-down
// leyendo este árbol persistido — nunca recalcula por su cuenta.
model CalculationNode {
  id                 String            @id @default(uuid()) @db.Uuid
  runId              String            @db.Uuid
  run                CalculationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  parentId           String?           @db.Uuid
  parent             CalculationNode?  @relation("NodeChildren", fields: [parentId], references: [id])
  children           CalculationNode[] @relation("NodeChildren")
  ord                Int
  label              String
  formula            String?
  valueNum           Decimal?          @db.Decimal(18, 4)
  unit               String?
  sourceDpVersionIds String[]          @default([])

  @@index([runId, parentId, ord])
  @@map("calculation_nodes")
}

// ---------------------------------------------------------------------------
// Bases de asignación (Parte 4 — desbloquea el prorrateo)
// ---------------------------------------------------------------------------

// Catálogo de bases de distribución (criterio B — clase 12 de Mirta).
// `companyId` NULL = base del sistema (precargada, común a todos). Con
// `companyId` = base personalizada de esa empresa. Relaciones por scalar UUID
// (FK a nivel DB en la migración) para no tocar los modelos existentes.
model AllocationBase {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid // NULL = base del sistema
  code        String // 'superficie_m2', 'hs_maquina', 'focos'...
  name        String // 'Superficie en m²'
  unit        String // 'm²', 'hs máquina', 'focos', 'HP'...
  description String? // cuándo usarla
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz

  values AllocationBaseValue[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("allocation_bases")
}

// Valor de una base para un centro dentro de una estructura/período. Es un
// dato TRAZABLE: puede enlazar a su DataPoint (autor, versión, evidencia).
model AllocationBaseValue {
  id          String         @id @default(uuid()) @db.Uuid
  baseId      String         @db.Uuid
  base        AllocationBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  structureId String         @db.Uuid
  centerId    String // id del centro de costo (coincide con IndirectCostConfig.centers[].id)
  value       Decimal        @db.Decimal(18, 4)
  note        String? // 'superficie según plano municipal'
  dataPointId String?        @db.Uuid // enlace a la ficha del dato (trazabilidad)
  createdBy   String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz
  voidedAt    DateTime?      @db.Timestamptz // R1: borrado lógico

  @@unique([baseId, structureId, centerId])
  @@index([structureId])
  @@map("allocation_base_values")
}
